                "  n_Driver_LightMode([\"Driver_LightMode\"])",
                "  n_Driver_LightMode --> n_ExteriorLighting",
                "  n_Driver_HighBeam([\"Driver_HighBeam\"])",
                "  n_Driver_HighBeam --> n_ExteriorLighting",
                "  n_Driver_BrakePedalPosition([\"Driver_BrakePedalPosition\"])",
