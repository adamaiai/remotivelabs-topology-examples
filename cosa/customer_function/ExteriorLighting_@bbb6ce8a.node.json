                "  n_Lamp_FrontLeftDaylightRunning([\"Lamp_FrontLeftDaylightRunning\"])",
                "  n_ExteriorLighting --> n_Lamp_FrontLeftDaylightRunning",
                "  n_Lamp_FrontRightDaylightRunning([\"Lamp_FrontRightDaylightRunning\"])",
                "  n_ExteriorLighting --> n_Lamp_FrontRightDaylightRunning",
                "  n_Lamp_FrontLeftLowBeam([\"Lamp_FrontLeftLowBeam\"])",
                "  n_ExteriorLighting --> n_Lamp_FrontLeftLowBeam",
                "  n_Lamp_FrontRightLowBeam([\"Lamp_FrontRightLowBeam\"])",
                "  n_ExteriorLighting --> n_Lamp_FrontRightLowBeam",
                "  n_Lamp_FrontLeftHighBeam([\"Lamp_FrontLeftHighBeam\"])",
                "  n_ExteriorLighting --> n_Lamp_FrontLeftHighBeam",
                "  n_Lamp_FrontRightHighBeam([\"Lamp_FrontRightHighBeam\"])",
                "  n_ExteriorLighting --> n_Lamp_FrontRightHighBeam",
                "  n_Lamp_FrontLeftTurn([\"Lamp_FrontLeftTurn\"])",
                "  n_ExteriorLighting --> n_Lamp_FrontLeftTurn",
                "  n_Lamp_FrontRightTurn([\"Lamp_FrontRightTurn\"])",
