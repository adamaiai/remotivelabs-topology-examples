                "  n_port_in_HVACService_LeftTemperature([\"HVACService_LeftTemperature\"])",
                "  n_port_in_HVACService_RightTemperature([\"HVACService_RightTemperature\"])",
                "  n_port_out_Climate_LeftTemperature([\"Climate_LeftTemperature\"])",
                "  n_port_out_Climate_RightTemperature([\"Climate_RightTemperature\"])",
                "  n_ClimateActuation_GWM__8722707f -->|\"LeftTemperature<br/>RightTemperature\"| n_ClimateActuation_HVAC__f28b8a25",
                "  n_ClimateActuation_HVAC__f28b8a25 --> n_port_out_Climate_LeftTemperature",
                "  n_ClimateActuation_HVAC__f28b8a25 --> n_port_out_Climate_RightTemperature",
                "  n_port_in_HVACService_LeftTemperature --> n_ClimateActuation_GWM__8722707f",
                "  n_port_in_HVACService_RightTemperature --> n_ClimateActuation_GWM__8722707f",
                "```"
            ],
