        "metadata": {
            "uuid": "LightingIndication_@3d02c741",
            "description": [
                "Technical design (TSC level). DIM lights the turn and high beam telltales in the cluster; GWM forwards the turn indication to the infotainment unit over SOME/IP (UNECE R48 telltales).",
                "",
                "```mermaid",
                "flowchart LR",
                "  subgraph n_LightingIndication[\"LightingIndication\"]",
                "    n_LightingIndication_DIM__9456d695[\"DIM<br/>(DIM_Lighting)\"]",
                "    n_LightingIndication_GWM__94b06e1d[\"GWM<br/>(GWM_Lighting)\"]",
                "    n_LightingIndication_IHU__3846d472[\"IHU<br/>(IHU_Lighting)\"]",
                "  end",
                "  n_port_in_LeftDaylightRunningLightRequest(\"LeftDaylightRunningLightRequest<br/>LeftHighBeamLightRequest<br/>LeftLowBeamLightRequest<br/>RightDaylightRunningLightRequest<br/>RightHighBeamLightRequest<br/>RightLowBeamLightRequest\")",
                "  n_port_in_LeftTurnLightRequest([\"LeftTurnLightRequest\"])",
                "  n_port_in_RightTurnLightRequest([\"RightTurnLightRequest\"])",
                "  n_port_in_LeftBrakeLightRequest([\"LeftBrakeLightRequest\"])",
                "  n_port_in_RightBrakeLightRequest([\"RightBrakeLightRequest\"])",
                "  n_port_out_Cluster_LeftTurnTelltale([\"Cluster_LeftTurnTelltale\"])",
                "  n_port_out_Cluster_RightTurnTelltale([\"Cluster_RightTurnTelltale\"])",
                "  n_port_out_Cluster_HighBeamTelltale([\"Cluster_HighBeamTelltale\"])",
                "  n_port_out_Infotainment_LeftTurnIndicator([\"Infotainment_LeftTurnIndicator\"])",
                "  n_port_out_Infotainment_RightTurnIndicator([\"Infotainment_RightTurnIndicator\"])",
