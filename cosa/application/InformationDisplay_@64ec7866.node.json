        "metadata": {
            "uuid": "InformationDisplay_@64ec7866",
            "description": [
                "Technical design (TSC level). DIM shows information in the cluster; GWM forwards it to the infotainment unit over SOME/IP.",
                "",
                "```mermaid",
                "flowchart LR",
                "  subgraph n_InformationDisplay[\"InformationDisplay\"]",
                "    n_InformationDisplay_DIM__7611ed20[\"DIM<br/>(DIM_Info)\"]",
                "    n_InformationDisplay_GWM__f827b62e[\"GWM<br/>(GWM_Info)\"]",
                "    n_InformationDisplay_IHU__154ce01b[\"IHU<br/>(IHU_Info)\"]",
                "  end",
                "  n_port_in_ProximityDistance(\"BatteryCurrent<br/>BatteryPower<br/>BatteryVoltage<br/>MotorSpeed<br/>MotorTorque<br/>ProximityDistance<br/>StateOfCharge\")",
                "  n_port_in_Longitude([\"Longitude\"])",
                "  n_port_in_Latitude([\"Latitude\"])",
                "  n_port_in_Heading([\"Heading\"])",
                "  n_port_in_uispeed([\"uispeed\"])",
                "  n_port_out_Cluster_StateOfCharge([\"Cluster_StateOfCharge\"])",
