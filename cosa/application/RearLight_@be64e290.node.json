                "  n_RearLight_DEVS2__aa8e188d -->|\"SomePartNrDEVS2EndSgn1<br/>SomePartNrDEVS2EndSgn2<br/>SomePartNrDEVS2EndSgn3<br/>SomePartNrDEVS2Nr1<br/>SomePartNrDEVS2Nr2<br/>+2 more\"| n_RearLight_RLCM__a2749aba",
                "  n_RearLight_DEVS2__aa8e188d --> n_port_out_Lamp_RearLeftTurn",
                "  n_RearLight_DEVS2__aa8e188d --> n_port_out_Lamp_RearRightTurn",
                "  n_RearLight_RLCM__a2749aba -->|\"ReqLeft<br/>ReqRight<br/>SomeReq2Type2<br/>counter\"| n_RearLight_DEVS2__aa8e188d",
                "  n_RearLight_RLCM__a2749aba -->|\"SomeReq1<br/>counter\"| n_RearLight_RL__1b51fede",
                "  n_RearLight_RL__1b51fede -->|\"ErrRespDEVS1<br/>SomeQf<br/>counter_times_2\"| n_RearLight_RLCM__a2749aba",
                "  n_port_in_LeftDaylightRunningLightRequest --> n_RearLight_RLCM__a2749aba",
