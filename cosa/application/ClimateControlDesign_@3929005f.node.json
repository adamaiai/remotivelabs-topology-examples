                "  end",
                "  n_port_in_Occupant_LeftTemperatureSetpoint([\"Occupant_LeftTemperatureSetpoint\"])",
                "  n_port_in_Occupant_RightTemperatureSetpoint([\"Occupant_RightTemperatureSetpoint\"])",
                "  n_port_out_Climate_LeftTemperature([\"Climate_LeftTemperature\"])",
                "  n_port_out_Climate_RightTemperature([\"Climate_RightTemperature\"])",
                "  n_ClimateControlDesign_ClimateActuation__b3075767 --> n_port_out_Climate_LeftTemperature",
                "  n_ClimateControlDesign_ClimateActuation__b3075767 --> n_port_out_Climate_RightTemperature",
                "  n_ClimateControlDesign_ClimateSetpointHMI__563017f6 -->|\"HVACService_LeftTemperature<br/>HVACService_RightTemperature\"| n_ClimateControlDesign_ClimateActuation__b3075767",
                "  n_port_in_Occupant_LeftTemperatureSetpoint --> n_ClimateControlDesign_ClimateSetpointHMI__563017f6",
                "  n_port_in_Occupant_RightTemperatureSetpoint --> n_ClimateControlDesign_ClimateSetpointHMI__563017f6",
                "```"
            ],
